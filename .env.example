# ---------------------------------------------------------------------------
# Outgoing mail (SMTP)
# ---------------------------------------------------------------------------
# Only used with --sendemail; the poller ignores this block otherwise.
#
# Gmail: turn on 2-Step Verification, then generate an app password at
# https://myaccount.google.com/apppasswords. Paste it with or without the
# spaces Google shows - they are stripped either way.
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
SENDER_EMAIL = "your_email@gmail.com"
APP_PASSWORD = "xxxxxxxxxxxxxxxx"  # 16-character app password, NOT the account password
# One address, or several separated by commas.
RECEIVER_EMAIL = "recipient@example.com"
#
# Microsoft accounts will NOT work here. Both smtp.office365.com and
# smtp-mail.outlook.com now answer an app password with
#   535 5.7.139 Authentication unsuccessful, basic authentication is disabled
# on personal Hotmail/Outlook.com addresses and on tenant mailboxes alike. A
# tenant admin can re-enable it per mailbox ("Authenticated SMTP"); a personal
# account has no such switch and needs OAuth2 instead.

# ---------------------------------------------------------------------------
# TP-Link Kasa credentials
# ---------------------------------------------------------------------------
# Required for newer devices (KLAP / AES protocol: most 2022+ hardware and any
# device on recent firmware). Use the same email/password as your TP-Link Kasa
# cloud account. Older devices ignore these and work unauthenticated.
KASA_USERNAME=
KASA_PASSWORD=

# ---------------------------------------------------------------------------
# Discovery
# ---------------------------------------------------------------------------
# Broadcast address for your LAN. 255.255.255.255 works on a flat network, but
# many Windows/multi-NIC setups need the subnet-directed broadcast instead,
# e.g. 192.168.1.255 for a 192.168.1.0/24 network.
KASA_DISCOVERY_TARGET=255.255.255.255

# Seconds to listen for discovery replies. Raise to 10 on slow/busy Wi-Fi.
KASA_DISCOVERY_TIMEOUT=5

# Optional: skip broadcast discovery entirely and poll these IPs directly.
# Comma-separated. Useful when broadcast is blocked (VLANs, guest Wi-Fi, WSL).
# Example: KASA_HOSTS=192.168.1.50,192.168.1.51
KASA_HOSTS=

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# table | json
KASA_OUTPUT_FORMAT=table

# ---------------------------------------------------------------------------
# API push (only used with --push-api)
# ---------------------------------------------------------------------------
# Base URL of sensors-backend-fastapi, including the /v1 path segment --
# through nginx on rpi4-api, not uvicorn directly.
API_BASE_URL=http://10.0.0.13/v1
